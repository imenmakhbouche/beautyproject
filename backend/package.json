{
  "name": "clinic-backend",
  "version": "1.0.0",
  "description": "Backend for Clinic App using Express and Prisma",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:setup": "prisma db push && prisma generate"
  },
  "nodemonConfig": {
    "watch": ["src", "server.js", "node_modules/@prisma/client"],
    "ext": "js,json",
    "ignore": ["node_modules/@prisma/client/runtime"]
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}
